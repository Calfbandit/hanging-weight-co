[Unit]
Description=Hanging Weight Co. collector + board data (api/server.js)
After=network.target

[Service]
User=hwboard
Group=hwboard
Environment=HW_DATA=/var/lib/hw-board HW_API_PORT=8791
# Optional, set in /etc/hw-board/api.env (chmod 600): SENDGRID_API_KEY, FROM_EMAIL, NOTIFY_EMAIL, STRIPE_WEBHOOK_SECRET, HW_ORIGINS
# Gmail + Calendar (api/google.js), also in /etc/hw-board/api.env: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, HW_TOKEN_KEY (32+ random chars),
# optional GOOGLE_REDIRECT_URI (default https://board.hangingweightco.com/api/google/callback).
# Allen's Google sign-in is kept encrypted in /var/lib/hw-board/google.json (chmod 600); changing HW_TOKEN_KEY means connecting again.
EnvironmentFile=-/etc/hw-board/api.env
ExecStart=/usr/bin/node-22 /opt/hw-board/api/server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hw-board
PrivateTmp=true

[Install]
WantedBy=multi-user.target
